generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrderStatus{
  PENDIENTE
  PAGADO
  ENTREGADA
  CANCELADA
}
model Order{
id String @id @default(uuid())
totalAmount Float
totaItems Int

status OrderStatus @default(PENDIENTE)
paid Boolean @default(false)
paiAt DateTime?
stripeCharteId String?

createdAt DateTime @default(now())
updateAt DateTime @updatedAt

OrderItem OrderItem[]
orderId OrderReceipt?
}
model OrderItem{
 id   String @id @default(uuid())
 productId Int
 quantity Int
 price Float
 
 Order Order? @relation(fields:[orderId],references: [id])
 orderId String?
}
model OrderReceipt{
id String @id @default(uuid())

order Order @relation(fields: [orderId], references: [id])
orderId String @unique

recaiptUrl String

createdAt DateTime @default(now())
updateAt DateTime @updatedAt
}